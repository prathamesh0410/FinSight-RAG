# App
APP_NAME="FinSight RAG"
APP_ENV="development"
DEBUG=true
SECRET_KEY="generate-with-openssl-rand-hex-32"
API_V1_PREFIX="/api/v1"

# Database (PostgreSQL + pgvector)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/finsight"
# For Docker: postgresql+asyncpg://postgres:postgres@db:5432/finsight

# Redis
REDIS_URL="redis://localhost:6379/0"

# ChromaDB (alternative vector store)
CHROMA_PERSIST_DIR="./data/chroma"
CHROMA_COLLECTION_NAME="documents"

# OpenAI
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-4o-mini"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# Anthropic (alternative)
ANTHROPIC_API_KEY="sk-ant-..."
ANTHROPIC_MODEL="claude-3-haiku-20240307"

# Chunking
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
CHUNKING_STRATEGY="legal"  # legal, recursive, semantic, markdown

# Retrieval
TOP_K=5
SIMILARITY_THRESHOLD=0.7
USE_RERANKER=true
RERANKER_MODEL="cross-encoder/ms-marco-MiniLM-L-6-v2"
BM25_WEIGHT=0.4
VECTOR_WEIGHT=0.6

# Embeddings
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DIMENSION=1536

# Ingestion
MAX_FILE_SIZE_MB=50
SUPPORTED_EXTENSIONS=".pdf,.docx,.txt,.md"
INGESTION_QUEUE="ingestion"

# Evaluation
RAGAS_ENABLED=true
EVAL_SAMPLE_RATE=0.1

# Streamlit
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS="0.0.0.0"
API_BASE_URL="http://localhost:8000/api/v1"

# Monitoring
LOG_LEVEL="INFO"
METRICS_ENABLED=true